SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
GITHUB_WEBHOOK_SECRET=
# Comma-separated browser origins allowed to call /api; empty means "*".
CORS_ALLOWED_ORIGINS=

# PR evaluations via the CRE runner (cre-test/cmd/runner). Empty EVALUATOR_URL = disabled.
EVALUATOR_URL=
# The runner's RUNNER_SHARED_SECRET.
EVALUATOR_SECRET=
EVALUATION_CONCURRENCY=2
# Bearer key for POST /api/evaluations (manual runs). openssl rand -hex 32
ADMIN_API_KEY=
